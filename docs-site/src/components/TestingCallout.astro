---
import CalloutRow from './CalloutRow.astro';

interface Props {
  t: any;
  locale: string;
}

const { t, locale } = Astro.props;
const c = t.testingCallout;
const href = locale === 'en' ? '/prisma-sql/testing' : `/prisma-sql/${locale}/testing`;
---

<CalloutRow href={href} badge={c.badge} title={c.title} description={c.description} link={c.link} />
