---
import { GENERATOR_SNIPPET, INSTALL_SNIPPET, QUERY_SNIPPET, SETUP_SNIPPET } from '../lib/code';

interface Props {
  t: any;
}

const { t } = Astro.props;
const ins = t.installation;

const blocks = [
  [{ file: 'Terminal', lang: 'language-bash', code: INSTALL_SNIPPET }],
  [
    { file: 'schema.prisma', lang: 'language-plaintext', code: GENERATOR_SNIPPET },
    { file: 'Terminal', lang: 'language-bash', code: 'npx prisma generate' },
    { file: 'db.ts', lang: 'language-typescript', code: SETUP_SNIPPET },
  ],
  [{ file: 'users.ts', lang: 'language-typescript', code: QUERY_SNIPPET }],
];

const steps = ins.steps.map((step: any, i: number) => ({ title: step.title, blocks: blocks[i] ?? [] }));
---

<section class="border-b border-line py-20 sm:py-28" id="install">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{ins.title}</h2>
      <p class="text-lg">{ins.subtitle}</p>
    </div>

    <ol>
      {steps.map((step: any, index: number) => (
        <li class="grid gap-6 border-t border-line py-10 lg:grid-cols-12 lg:gap-10">
          <div class="lg:col-span-4">
            <span class="num block text-6xl font-bold leading-none text-amber" aria-hidden="true">{index + 1}</span>
            <h3 class="display-3 mt-4">{step.title}</h3>
          </div>
          <div class="grid gap-4 lg:col-span-8">
            {step.blocks.map((block: any) => (
              <div class="code-surface overflow-hidden">
                <div class="border-b border-white/10 px-5 py-2 font-mono text-xs text-[#9fb4c0]">{block.file}</div>
                <pre class="p-5 text-[0.85rem] leading-relaxed" dir="ltr"><code class={block.lang}>{block.code}</code></pre>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ol>

    <p class="mt-4 text-fog">
      SQLite: pass <code class="text-ink">{'speedExtension({ sqlite: db })'}</code> with a <code class="text-ink">better-sqlite3</code> database.
      <a href="/prisma-sql/docs" class="link-underlined ms-1 text-ink">Full setup guide</a>
    </p>
  </div>
</section>
