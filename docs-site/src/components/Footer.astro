---
interface Props {
  t: any;
  locale: string;
}

const { t, locale } = Astro.props;

const root = '/prisma-sql';
const localeRoot = (code: string) => (code === 'en' ? `${root}/` : `${root}/${code}/`);

const languages = [
  { code: 'en', label: 'English' },
  { code: 'es', label: 'Español' },
  { code: 'fr', label: 'Français' },
  { code: 'pt', label: 'Português' },
  { code: 'hi', label: 'हिन्दी' },
  { code: 'bn', label: 'বাংলা' },
  { code: 'ar', label: 'العربية' },
  { code: 'ur', label: 'اردو' },
  { code: 'ru', label: 'Русский' },
  { code: 'zh', label: '中文' },
];

const productLinks = [
  { href: `${root}/docs`, label: 'Documentation' },
  { href: `${root}/docs/parity`, label: 'Prisma parity map' },
  { href: `${localeRoot(locale)}#benchmarks`, label: 'Benchmarks' },
  { href: `${localeRoot(locale)}testing`, label: 'Testing' },
  { href: `${localeRoot(locale)}sql-prevention`, label: 'SQL injection prevention' },
];

const externalLinks = [
  { href: 'https://github.com/multipliedtwice/prisma-sql', label: 'GitHub' },
  { href: 'https://www.npmjs.com/package/prisma-sql', label: 'npm' },
  { href: 'https://github.com/multipliedtwice/prisma-sql/blob/main/CHANGELOG.md', label: 'Changelog' },
];
---

<footer class="overflow-hidden bg-ink-deep pt-16 text-[#B7C9D2] sm:pt-20">
  <div class="page-x">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <p class="text-3xl font-bold text-paper" style="font-stretch: 80%">prisma-sql</p>
        <p class="mt-3 max-w-[36ch]">{t.footer.tagline}</p>
      </div>

      <nav class="md:col-span-3" aria-label="Product">
        <ul class="space-y-2.5">
          {productLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-paper">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-label="Elsewhere">
        <ul class="space-y-2.5">
          {externalLinks.map((link) => (
            <li><a href={link.href} class="transition-colors hover:text-paper">{link.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="md:col-span-2" aria-label="Language">
        <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm md:grid-cols-1">
          {languages.map((lang) => (
            <li>
              <a
                href={localeRoot(lang.code)}
                lang={lang.code}
                aria-current={locale === lang.code ? 'true' : undefined}
                class:list={['transition-colors hover:text-paper', locale === lang.code && 'font-semibold text-amber']}
              >
                {lang.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <p class="mt-16 border-t border-white/10 pt-6 text-sm text-[#8FA6B3]">{t.footer.copyright}</p>
  </div>
  <div class="page-x mt-10 select-none" dir="ltr" aria-hidden="true" data-scrub data-scrub-start="1" data-scrub-span="0.9">
    <p class="footer-mark">prisma-sql</p>
  </div>
</footer>
