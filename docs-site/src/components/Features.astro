---
interface Props {
  t: any;
}

const { t } = Astro.props;
const f = t.features;
---

<section class="border-b border-line bg-ink py-20 text-paper sm:py-28">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{f.title}</h2>
      <p class="text-lg !text-[#B7C9D2]">{f.subtitle}</p>
    </div>

    <dl class="grid gap-px overflow-hidden rounded-2xl bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
      {f.items.map((feature: any) => (
        <div class="bg-ink p-7 sm:p-8">
          <dt class="text-xl font-semibold">{feature.title}</dt>
          <dd class="mt-2 text-[#B7C9D2]">{feature.description}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
