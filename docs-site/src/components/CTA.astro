---
import CtaBand from './CtaBand.astro'

interface Props {
  t: any
}

const { t } = Astro.props
---

<CtaBand
  title={t.cta.title}
  subtitle={t.cta.subtitle}
  links={[
    { href: 'https://www.npmjs.com/package/prisma-sql', label: t.cta.button1 },
    { href: 'https://github.com/multipliedtwice/prisma-sql', label: t.cta.button2 },
  ]}
/>
