---
import { cleanLabel } from '../lib/text';

interface Props {
  t: any;
}

const { t } = Astro.props;
const e = t.extras;
---

<section class="border-b border-line py-20 sm:py-28" id="extras">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{e.title}</h2>
      <p class="text-lg">{e.subtitle}</p>
    </div>

    <div class="grid gap-10 lg:grid-cols-3 lg:gap-8">
      {e.items.map((item: any) => (
        <article class="flex flex-col">
          <h3 class="font-mono text-lg font-semibold text-ink">{item.name}</h3>
          <p class="mt-1 text-lg font-semibold text-ink">{cleanLabel(item.tagline)}</p>
          <p class="mt-3 flex-1 text-fog">{item.description}</p>
          <div class="code-surface mt-6">
            <pre class="p-5 text-[0.8rem] leading-relaxed" dir="ltr"><code>{item.code}</code></pre>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
