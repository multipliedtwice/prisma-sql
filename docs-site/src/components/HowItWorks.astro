---
interface Props {
  t: any;
}

const { t } = Astro.props;
const h = t.howItWorks;
---

<section class="border-b border-line py-20 sm:py-28" id="how">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{h.title}</h2>
      <p class="text-lg">{h.subtitle}</p>
    </div>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <ol class="lg:col-span-7" data-steps>
        {h.steps.map((step: any, index: number) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-t border-line py-7 sm:grid-cols-[5rem_1fr]">
            <span class="step-num num text-5xl font-bold leading-none text-ink/25 sm:text-6xl" aria-hidden="true">
              {index + 1}
            </span>
            <div>
              <h3 class="text-xl font-semibold text-ink">{step.title}</h3>
              <p class="mt-2 max-w-[56ch] text-fog">{step.description}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="lg:col-span-5">
        <div class="code-surface lg:sticky lg:top-24">
          <pre class="p-5 text-[0.85rem] leading-relaxed sm:p-6" dir="ltr"><code class="language-typescript">{h.codeExample}</code></pre>
        </div>
      </div>
    </div>
  </div>
</section>
