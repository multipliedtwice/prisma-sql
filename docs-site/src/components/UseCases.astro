---
import { cleanLabel } from '../lib/text';

interface Props {
  t: any;
}

const { t } = Astro.props;
const u = t.useCases;
---

<section class="border-b border-line bg-paper-2/60 py-20 sm:py-28">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{u.title}</h2>
      <p class="text-lg">{u.subtitle}</p>
    </div>

    <div class="grid gap-x-10 md:grid-cols-2">
      {u.cases.map((useCase: any) => (
        <article class="border-t-2 border-ink py-8">
          <h3 class="display-3">{cleanLabel(useCase.title)}</h3>
          <p class="mt-3 max-w-[52ch] text-fog">{useCase.description}</p>
          <ul class="mt-5 space-y-2">
            {useCase.benefits.map((benefit: string) => (
              <li class="flex items-start gap-3 text-ink">
                <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-pine" aria-hidden="true"></span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
