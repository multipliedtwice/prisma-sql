---
interface Props {
  t: any;
}

const { t } = Astro.props;
const p = t.problem;
---

<section class="border-b border-line py-20 sm:py-28">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{p.title}</h2>
      <p class="text-lg">{p.subtitle}</p>
    </div>

    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-24">
          <h3 class="display-3">{p.historyTitle}</h3>
          <div class="mt-6 border-s-2 border-amber ps-5">
            <h4 class="font-semibold text-ink">{p.whyExists.title}</h4>
            <p class="mt-2 text-fog">{p.whyExists.description}</p>
          </div>
        </div>
      </div>

      <ol class="timeline relative lg:col-span-8 lg:ms-6" data-scrub data-scrub-start="0.6">
        {p.history.map((item: any) => (
          <li class="grid gap-2 border-t border-line py-6 sm:grid-cols-[11rem_1fr] sm:gap-8">
            <h4 class="font-bold text-ink">{item.period}</h4>
            <p class="max-w-[62ch] text-ink/80">{item.description}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-line bg-line md:grid-cols-3">
      {p.technical.map((item: any) => (
        <article class="bg-paper p-6 sm:p-8">
          <h3 class="text-lg font-semibold text-ink">{item.title}</h3>
          <p class="mt-2 text-fog">{item.description}</p>
        </article>
      ))}
    </div>

    <p class="mt-14 max-w-[46ch] text-[clamp(1.35rem,2.4vw,1.9rem)] font-medium leading-snug text-ink">
      {p.conclusion}
    </p>
  </div>
</section>
