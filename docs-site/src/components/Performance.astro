---
import {
  dialectLabel,
  loadBenchmarkResults,
  prismaVersionLabel,
  type BenchmarkDialect,
} from '../lib/benchmark-data'

interface Props {
  t: any
}

const { t } = Astro.props

const results = loadBenchmarkResults()
const dialects: BenchmarkDialect[] = ['postgres', 'sqlite']

function fmtX(value: number): string {
  return `${value.toFixed(2)}×`
}

const globalMax = Math.max(1, ...results.map(r => r.avgSpeedupVsPrisma))

const cards = dialects
  .map(dialect => {
    const dialectResults = results
      .filter(result => result.dialect === dialect)
      .sort((a, b) => a.version - b.version)
    const bestSpeedup = Math.max(0, ...dialectResults.map(r => r.avgSpeedupVsPrisma))

    return {
      name: dialectLabel(dialect),
      cases: dialectResults[0]?.tests.length ?? 0,
      rows: dialectResults.map(result => ({
        label: prismaVersionLabel(result.version),
        width: Math.max(8, (result.avgSpeedupVsPrisma / globalMax) * 100),
        speedup: fmtX(result.avgSpeedupVsPrisma),
        best: result.avgSpeedupVsPrisma === bestSpeedup,
        drizzleSpeedup: result.avgSpeedupVsDrizzle > 0 ? fmtX(result.avgSpeedupVsDrizzle) : null,
        tests: result.tests.length,
        timestamp: result.timestamp
          ? new Date(result.timestamp).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
          : '',
      })),
    }
  })
  .filter(card => card.rows.length > 0)

const hasBenchmarkData = cards.length > 0
---

<section class="border-b border-line py-20 sm:py-28" id="speed">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{t.performance.title}</h2>
      <p class="text-lg">{t.performance.subtitle}</p>
    </div>

    {!hasBenchmarkData && <p class="text-fog">No benchmark JSON files found.</p>}

    {hasBenchmarkData && (
      <div class="grid gap-14 lg:grid-cols-2 lg:gap-12">
        {cards.map(card => (
          <article>
            <header class="flex items-baseline justify-between gap-4 border-b-2 border-ink pb-3">
              <h3 class="display-3">{card.name}</h3>
              <span class="text-sm text-fog">{card.cases} query cases per run</span>
            </header>

            <ul data-bars>
              {card.rows.map(row => (
                <li class="border-b border-line py-5">
                  <div class="flex items-baseline justify-between gap-4">
                    <span class="font-semibold text-ink">{row.label}</span>
                    <span class="num text-sm text-fog">
                      {row.drizzleSpeedup && <>{row.drizzleSpeedup} vs Drizzle</>}
                    </span>
                  </div>
                  <div class="mt-3 flex items-center gap-4">
                    <div class="h-3 flex-1 rounded-full bg-paper-2" aria-hidden="true">
                      <div
                        data-bar
                        class:list={['h-3 rounded-full', row.best ? 'bg-amber' : 'bg-ink']}
                        style={`width: ${row.width}%`}
                      ></div>
                    </div>
                    <span class="num w-[5.5ch] text-end text-2xl font-bold leading-none text-ink">
                      {row.speedup}
                    </span>
                  </div>
                  <p class="sr-only">{row.label}: {row.speedup} average speedup versus Prisma</p>
                  <div class="mt-2 flex justify-between gap-2 text-xs text-fog">
                    <span>{row.tests} measured query cases, average vs Prisma</span>
                    {row.timestamp && <span>{row.timestamp}</span>}
                  </div>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    )}

    <p class="mt-10 max-w-[70ch] text-sm text-fog">
      Generated at build time from the latest <code class="text-ink">benchmark-results/*-latest.json</code> files. Bars share one scale across both databases; amber marks the best run per database. Individual query shapes vary.
      <a href="#benchmarks" class="link-underlined ms-1 me-3 text-ink">Per-query table</a>
      <a href="https://github.com/multipliedtwice/prisma-sql/tree/main/benchmark-results" class="link-underlined text-ink">{t.performance.footerLink}</a>
    </p>
  </div>
</section>
