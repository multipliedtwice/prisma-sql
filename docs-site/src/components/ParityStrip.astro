---
import en from '../i18n/en.json';
import {
  PARITY_ROWS,
  STATUS_META,
  STATUS_ORDER,
  countByStatus,
  inlineCode,
  rowsByGroup,
  type ParityStatus,
} from '../lib/parity-data';

interface Props {
  t: any;
}

const { t } = Astro.props;
const copy = t.parity ?? en.parity;

const groups = rowsByGroup(PARITY_ROWS);
const flatRows = groups.flatMap((g) => g.rows);
const lanes = [
  { db: 'pg' as const, label: 'PostgreSQL' },
  { db: 'sqlite' as const, label: 'SQLite' },
];
const pgCounts = countByStatus(PARITY_ROWS, 'pg');
const sqliteCounts = countByStatus(PARITY_ROWS, 'sqlite');
const legend = STATUS_ORDER.filter((s) => pgCounts[s] + sqliteCounts[s] > 0);

const summary = String(copy.summary)
  .replace('{accelerated}', String(pgCounts.accelerated))
  .replace('{total}', String(PARITY_ROWS.length))
  .replace('{differs}', String(pgCounts.differs));

const tileLabel = (feature: string, status: ParityStatus, db: string) =>
  `${feature}, ${db}: ${STATUS_META[status].label}`;
---

<section class="border-b border-line py-20 sm:py-28" id="parity">
  <div class="page-x">
    <div class="section-head">
      <h2 class="display-2">{copy.title}</h2>
      <p class="text-lg">{copy.subtitle}</p>
    </div>

    <div class="overflow-x-auto pb-2" dir="ltr" data-tip-scroll>
      <div class="min-w-[46rem]" data-tiles data-tip-grid role="group" aria-label="Status of each checked Prisma Client feature on PostgreSQL and SQLite, grouped by area. Use arrow keys to move between features.">
        {lanes.map((lane) => (
          <div class="grid grid-cols-[6.5rem_1fr] items-center gap-4 py-1.5">
            <span class="text-sm font-semibold text-ink">{lane.label}</span>
            <div class="flex gap-3">
              {groups.map((g) => (
                <div class="flex flex-1 gap-[3px]" style={`flex-grow:${g.rows.length}`}>
                  {g.rows.map((row) => (
                    <button
                      type="button"
                      class={`tile st st-${row[lane.db]} block h-10 flex-1 rounded-[3px] sm:h-12`}
                      data-tile={flatRows.indexOf(row)}
                      data-db={lane.db}
                      data-status={row[lane.db]}
                      tabindex={lane.db === 'pg' && flatRows.indexOf(row) === 0 ? '0' : '-1'}
                      aria-label={tileLabel(row.feature, row[lane.db], lane.label)}
                      aria-describedby="parity-tip"
                    ></button>
                  ))}
                </div>
              ))}
            </div>
          </div>
        ))}
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 pt-2">
          <span></span>
          <div class="flex gap-3">
            {groups.map((g) => (
              <span class="flex-1 border-t border-ink pt-2 text-xs leading-tight text-fog" style={`flex-grow:${g.rows.length}`}>
                {g.group}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-12">
      <p class="text-[clamp(1.25rem,2vw,1.6rem)] font-medium leading-snug text-ink lg:col-span-5">
        {summary}
      </p>
      <table class="w-full text-sm lg:col-span-7">
        <caption class="sr-only">Feature count by status</caption>
        <thead>
          <tr class="border-b border-ink text-start text-fog">
            <th scope="col" class="py-2 text-start font-medium">Status</th>
            <th scope="col" class="num py-2 text-end font-medium">PostgreSQL</th>
            <th scope="col" class="num py-2 text-end font-medium">SQLite</th>
          </tr>
        </thead>
        <tbody>
          {legend.map((s) => (
            <tr class="border-b border-line" data-legend={s}>
              <th scope="row" class="py-2.5 text-start font-normal">
                <span class="flex items-center gap-3">
                  <span class={`st st-${s} inline-block h-3.5 w-3.5 shrink-0 rounded-[3px]`} aria-hidden="true"></span>
                  <span class="font-semibold text-ink">{STATUS_META[s].label}</span>
                </span>
              </th>
              <td class="num py-2.5 text-end text-ink">{pgCounts[s]}</td>
              <td class="num py-2.5 text-end text-ink">{sqliteCounts[s]}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div id="parity-tip" popover="manual" role="tooltip" class="parity-tip" data-tip></div>

    {flatRows.map((row, i) => (
      <template data-tip-content={i}>
        <p class="text-xs text-[#8FA6B3]">{row.group}</p>
        <p class="mt-0.5 font-mono text-[0.95rem] font-semibold text-paper">{row.feature}</p>
        <dl class="mt-3 grid gap-1.5 text-sm">
          {lanes.map((lane) => (
            <div class="tip-lane flex items-center justify-between gap-4" data-lane={lane.db}>
              <dt>{lane.label}</dt>
              <dd class="flex items-center gap-2 font-semibold">
                <span class={`st st-${row[lane.db]} inline-block h-3 w-3 shrink-0 rounded-[2px]`} aria-hidden="true"></span>
                {STATUS_META[row[lane.db]].label}
              </dd>
            </div>
          ))}
        </dl>
        {lanes.map((lane) => (
          <p class="tip-desc mt-3 text-sm text-[#B7C9D2]" data-lane={lane.db}>{STATUS_META[row[lane.db]].description}</p>
        ))}
        {row.note && <p class="tip-note mt-2 text-sm text-paper" set:html={inlineCode(row.note)} />}
        <p class="mt-3 border-t border-white/10 pt-2 text-xs text-[#8FA6B3]">
          Prisma supports it on: {row.prisma}
          {!row.verified && <span class="mt-1 block">Inferred from the source; not confirmed by a test run.</span>}
        </p>
      </template>
    ))}

    <a href="/prisma-sql/docs/parity/" class="btn-solid mt-10">{copy.link}</a>
  </div>
</section>

<script>
  import '../scripts/parity-tips'
</script>
