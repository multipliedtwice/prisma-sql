---
import { PARITY_ROWS } from '../lib/parity-data'

const terms = PARITY_ROWS.filter((row) => row.pg === 'accelerated' && row.sqlite === 'accelerated')
  .flatMap((row) => row.feature.split(/,\s*/))
  .filter((term) => /^[\w$]+$/.test(term))

const copies = [0, 1]
---

<section class="marquee overflow-hidden border-b border-line bg-paper py-8 sm:py-10" data-marquee aria-label="Prisma Client features compiled to SQL on both PostgreSQL and SQLite">
  <div class="marquee-track flex w-max will-change-transform" dir="ltr" data-marquee-track>
    {copies.map((copy) => (
      <ul class="flex shrink-0 items-center" aria-hidden={copy === 1 ? 'true' : undefined}>
        {terms.map((term, i) => (
          <li class="flex items-center">
            <span class:list={['marquee-word', i % 2 === 1 && 'is-outline']}>{term}</span>
            <span class="marquee-dot" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>
