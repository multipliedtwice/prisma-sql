---
import {
  dialectLabel,
  loadBenchmarkResults,
  prismaVersionLabel,
  type BenchmarkResult,
  type BenchmarkStats,
  type BenchmarkTest,
} from '../lib/benchmark-data'

interface Props {
  t: any
}

const { t } = Astro.props

interface Significance {
  tStat: number
  df: number
  pBucket: string
  significant: boolean
  stars: string
  practicallySignificant: boolean
}

const PRACTICAL_THRESHOLD_MS = 1.0

function welchTTest(
  mean1: number, std1: number, n1: number,
  mean2: number, std2: number, n2: number,
): Significance {
  const empty: Significance = {
    tStat: 0, df: 0, pBucket: 'N/A',
    significant: false, stars: '', practicallySignificant: false,
  }

  if (n1 < 2 || n2 < 2) return empty

  const absDiff = Math.abs(mean1 - mean2)
  if (absDiff < PRACTICAL_THRESHOLD_MS) {
    return {
      tStat: 0, df: 0, pBucket: `Δ < ${PRACTICAL_THRESHOLD_MS}ms`,
      significant: false, stars: '', practicallySignificant: false,
    }
  }

  const v1 = (std1 * std1) / n1
  const v2 = (std2 * std2) / n2
  const se = Math.sqrt(v1 + v2)
  if (se === 0) return empty

  const tStat = (mean1 - mean2) / se
  const num = (v1 + v2) ** 2
  const den = (v1 * v1) / (n1 - 1) + (v2 * v2) / (n2 - 1)
  const df = den > 0 ? num / den : 1
  const absT = Math.abs(tStat)

  let pBucket: string
  let significant: boolean
  let stars: string

  if (absT > 3.891) { pBucket = 'p < 0.001'; significant = true; stars = '***' }
  else if (absT > 2.576) { pBucket = 'p < 0.01'; significant = true; stars = '**' }
  else if (absT > 1.96) { pBucket = 'p < 0.05'; significant = true; stars = '*' }
  else { pBucket = 'p ≥ 0.05'; significant = false; stars = '' }

  return {
    tStat: Math.round(tStat * 100) / 100,
    df: Math.round(df * 10) / 10,
    pBucket, significant, stars,
    practicallySignificant: significant && absDiff >= PRACTICAL_THRESHOLD_MS,
  }
}

function fmtMs(n: number): string {
  if (n < 0.01) return n.toFixed(4)
  if (n < 1) return n.toFixed(3)
  return n.toFixed(2)
}

function fmtX(n: number): string {
  return n.toFixed(2) + 'x'
}

function ciMargin(stats: BenchmarkStats): number {
  if (stats.iterations < 2) return 0
  return 1.96 * stats.stdDev / Math.sqrt(stats.iterations)
}

function tpl(template: string, vars: Record<string, string | number>): string {
  let out = template
  for (const [k, v] of Object.entries(vars)) {
    out = out.replaceAll(`{${k}}`, String(v))
  }
  return out
}

const results: BenchmarkResult[] = loadBenchmarkResults()

interface ProcessedTest {
  test: BenchmarkTest
  vsPrisma: Significance
  vsDrizzle: Significance | null
  extendedCi: number
  prismaCi: number
  drizzleCi: number | null
  absDiff: number
}

interface ProcessedResult {
  result: BenchmarkResult
  tests: ProcessedTest[]
  hasDrizzle: boolean
  tabId: string
  tabLabel: string
  tabLabelShort: string
  versionLabel: string
  significantWins: number
  significantRegressions: number
  withinNoise: number
}

const processed: ProcessedResult[] = results.map(r => {
  const hasDrizzle = r.tests.some(t => t.drizzleMs > 0)
  const tests: ProcessedTest[] = r.tests.map(test => {
    const vsPrisma = welchTTest(
      test.prismaStats.mean, test.prismaStats.stdDev, test.prismaStats.iterations,
      test.extendedStats.mean, test.extendedStats.stdDev, test.extendedStats.iterations,
    )
    const vsDrizzle = test.drizzleStats
      ? welchTTest(
          test.drizzleStats.mean, test.drizzleStats.stdDev, test.drizzleStats.iterations,
          test.extendedStats.mean, test.extendedStats.stdDev, test.extendedStats.iterations,
        )
      : null
    const absDiff = Math.abs(test.prismaStats.mean - test.extendedStats.mean)
    return { test, vsPrisma, vsDrizzle, extendedCi: ciMargin(test.extendedStats), prismaCi: ciMargin(test.prismaStats), drizzleCi: test.drizzleStats ? ciMargin(test.drizzleStats) : null, absDiff }
  })

  const tabId = `${r.dialect}-v${r.version}`
  const databaseLabel = dialectLabel(r.dialect)
  const tabLabelShort = r.dialect === 'postgres' ? 'PG' : 'SQLite'
  const versionLabel = prismaVersionLabel(r.version)

  return {
    result: r, tests, hasDrizzle, tabId, versionLabel,
    tabLabel: `${databaseLabel} ${versionLabel}`,
    tabLabelShort: `${tabLabelShort} v${r.version}`,
    significantWins: tests.filter(t => t.vsPrisma.practicallySignificant && t.test.speedupVsPrisma >= 1.0).length,
    significantRegressions: tests.filter(t => t.vsPrisma.practicallySignificant && t.test.speedupVsPrisma < 1.0).length,
    withinNoise: tests.filter(t => t.absDiff < PRACTICAL_THRESHOLD_MS).length,
  }
})

const hasData = processed.length > 0
const b = t.benchmarks
---

<section class="border-b border-line bg-ink-deep py-20 text-[#D6E3E8] sm:py-28" id="benchmarks">
  <div class="page-x">
    <div class="section-head !mb-10">
      <h2 class="display-2 text-paper">{b.title}</h2>
      <div class="lg:col-span-5 self-end">
      <p class="text-lg text-[#AFC2CC]">{b.subtitle}</p>
      <p class="text-sm text-[#8FA6B3] mt-3">
        <Fragment set:html={
          b.modeNote
            .replace('<runtime>', '<span class="text-paper font-medium">')
            .replace('</runtime>', '</span>')
            .replace('<prerendered>', '<span class="text-amber font-medium">')
            .replace('</prerendered>', '</span>')
        } />
      </p>
      </div>
    </div>

    {!hasData && (
      <div class="text-center text-[#8FA6B3] py-12">
        <p>{b.noData}</p>
        <p class="mt-2 text-sm" set:html={
          b.noDataHint.replace('<code>', '<code class="bg-white/[0.08] px-2 py-1 rounded text-sm">').replace('</code>', '</code>')
        } />
      </div>
    )}

    {hasData && (
      <div data-benchmark-tabs>
        <div class="flex flex-wrap gap-2 mb-8" role="tablist">
          {processed.map((p, i) => (
            <button
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${p.tabId}`}
              data-tab={p.tabId}
              class="benchmark-tab rounded-full border border-white/15 px-4 py-2 text-sm font-semibold transition-colors sm:px-5"
            >
              <span class="hidden sm:inline">{p.tabLabel}</span>
              <span class="sm:hidden">{p.tabLabelShort}</span>
              <span class="ml-2 text-xs">{p.result.avgSpeedupVsPrisma.toFixed(1)}x</span>
            </button>
          ))}
        </div>

        {processed.map((p, i) => (
          <div
            id={`panel-${p.tabId}`}
            role="tabpanel"
            data-panel={p.tabId}
            hidden={i !== 0}
          >
            <div class="flex flex-wrap items-baseline gap-3 mb-6">
              <h3 class="text-2xl font-bold">
                {p.result.dialect === 'postgres' ? 'PostgreSQL' : 'SQLite'}
                <span class="text-[#8FA6B3] font-normal text-lg ml-2">{p.versionLabel}</span>
              </h3>
              <div class="flex flex-wrap gap-3 text-sm">
                <span class="bg-pine/40 text-[#9FE3C3] px-3 py-1 rounded-full">
                  {tpl(b.avgVsPrisma, { speed: fmtX(p.result.avgSpeedupVsPrisma) })}
                </span>
                {p.result.avgSpeedupVsDrizzle > 0 && (
                  <span class="bg-steel/40 text-[#C4DAF5] px-3 py-1 rounded-full">
                    {tpl(b.avgVsDrizzle, { speed: fmtX(p.result.avgSpeedupVsDrizzle) })}
                  </span>
                )}
                <span class="bg-white/[0.08] text-[#AFC2CC] px-3 py-1 rounded-full">
                  {tpl(b.significantWins, { count: String(p.significantWins), total: String(p.tests.length) })}
                </span>
                {p.withinNoise > 0 && (
                  <span class="bg-white/[0.08] text-[#8FA6B3] px-3 py-1 rounded-full">
                    {tpl(b.withinNoise, { count: String(p.withinNoise) })}
                  </span>
                )}
              </div>
              {p.result.timestamp && (
                <span class="text-xs text-[#8FA6B3] ml-auto">
                  {new Date(p.result.timestamp).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              )}
            </div>

            <div class="max-h-[min(70vh,40rem)] overflow-auto rounded-2xl border border-white/10" tabindex="0" role="region" aria-label="Per-query benchmark results">
              <table class="w-full text-sm">
                <thead class="sticky top-0 z-[1] bg-[#0b2e42]">
                  <tr class="text-[#AFC2CC] text-xs">
                    <th class="text-left px-4 py-3 font-medium">{b.col.test}</th>
                    <th class="text-right px-4 py-3 font-medium">{b.col.prisma}</th>
                    <th class="text-right px-4 py-3 font-medium">{b.col.prismaSql}</th>
                    {p.hasDrizzle && <th class="text-right px-4 py-3 font-medium">{b.col.drizzle}</th>}
                    <th class="text-right px-4 py-3 font-medium">{b.col.speedup}</th>
                    <th class="text-center px-4 py-3 font-medium">{b.col.sig}</th>
                    <th class="text-right px-4 py-3 font-medium">{b.col.cv}</th>
                    <th class="text-right px-4 py-3 font-medium">{b.col.n}</th>
                  </tr>
                </thead>
                <tbody>
                  {p.tests.map(({ test, vsPrisma, vsDrizzle, extendedCi, prismaCi, absDiff }, i) => {
                    const isNoiseFloor = absDiff < PRACTICAL_THRESHOLD_MS
                    const isWin = !isNoiseFloor && test.speedupVsPrisma >= 1.0
                    const highCv = test.extendedStats.cv > 15 || test.prismaStats.cv > 15
                    const rowBg = i % 2 === 0 ? 'bg-white/[0.02]' : 'bg-white/[0.05]'

                    const speedupColor = isNoiseFloor
                      ? 'text-[#8FA6B3]'
                      : isWin
                        ? (vsPrisma.practicallySignificant ? 'text-[#9FE3C3]' : 'text-[#58A585]')
                        : (vsPrisma.practicallySignificant ? 'text-[#FFB4A4]' : 'text-[#C9624E]')

                    const timingColor = isNoiseFloor
                      ? 'text-[#8FA6B3]'
                      : isWin ? 'text-[#9FE3C3]' : 'text-[#FFB4A4]'

                    const sigTooltip = isNoiseFloor
                      ? `Δ = ${fmtMs(absDiff)}ms < ${PRACTICAL_THRESHOLD_MS}ms`
                      : `t=${vsPrisma.tStat}, df=${vsPrisma.df}, ${vsPrisma.pBucket}`

                    return (
                      <tr class={`${rowBg} border-t border-white/[0.07] hover:bg-white/[0.08] transition-colors`}>
                        <td class="px-4 py-3 font-medium text-paper max-w-[280px] truncate" title={test.name}>
                          {test.name}
                        </td>
                        <td class="px-4 py-3 text-right text-[#AFC2CC] tabular-nums whitespace-nowrap" title={`±${fmtMs(prismaCi)}ms (95% CI)`}>
                          {fmtMs(test.prismaMs)}ms
                          <span class="text-[#8FA6B3] text-xs ml-1">±{fmtMs(prismaCi)}</span>
                        </td>
                        <td class={`px-4 py-3 text-right tabular-nums whitespace-nowrap ${timingColor}`} title={`±${fmtMs(extendedCi)}ms (95% CI)`}>
                          <span class="font-semibold">{fmtMs(test.extendedMs)}ms</span>
                          <span class="text-[#8FA6B3] text-xs ml-1">±{fmtMs(extendedCi)}</span>
                        </td>
                        {p.hasDrizzle && (
                          <td class="px-4 py-3 text-right text-[#AFC2CC] tabular-nums whitespace-nowrap">
                            {test.drizzleMs > 0 ? `${fmtMs(test.drizzleMs)}ms` : '—'}
                          </td>
                        )}
                        <td class="px-4 py-3 text-right tabular-nums whitespace-nowrap">
                          <span class={`font-bold ${speedupColor}`}>
                            {isNoiseFloor ? '~1.00x' : fmtX(test.speedupVsPrisma)}
                          </span>
                          {p.hasDrizzle && test.speedupVsDrizzle > 0 && !isNoiseFloor && (
                            <span class={`ml-2 text-xs ${test.speedupVsDrizzle >= 1 ? 'text-[#A9C8F0]' : 'text-[#F4B183]'}`}>
                              {fmtX(test.speedupVsDrizzle)} D
                            </span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-center whitespace-nowrap" title={sigTooltip}>
                          {isNoiseFloor ? (
                            <span class="text-[#8FA6B3] text-xs">≈</span>
                          ) : vsPrisma.significant ? (
                            <span class="text-[#9FE3C3] font-mono text-xs">{vsPrisma.stars}</span>
                          ) : (
                            <span class="text-[#8FA6B3] text-xs">ns</span>
                          )}
                        </td>
                        <td class="px-4 py-3 text-right tabular-nums whitespace-nowrap">
                          <span
                            class={highCv ? 'text-amber' : 'text-[#8FA6B3]'}
                            title={`Prisma CV: ${test.prismaStats.cv.toFixed(1)}%, prisma-sql CV: ${test.extendedStats.cv.toFixed(1)}%`}
                          >
                            {test.extendedStats.cv.toFixed(1)}%
                          </span>
                        </td>
                        <td class="px-4 py-3 text-right text-[#8FA6B3] tabular-nums">
                          {test.extendedStats.iterations}
                        </td>
                      </tr>
                    )
                  })}
                </tbody>
              </table>
            </div>

            <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2 text-xs text-[#8FA6B3] px-1">
              <span><span class="text-[#9FE3C3] font-mono">***</span> {b.legend.p001}</span>
              <span><span class="text-[#9FE3C3] font-mono">**</span>&ensp;{b.legend.p01}</span>
              <span><span class="text-[#9FE3C3] font-mono">*</span>&ensp;&ensp;{b.legend.p05}</span>
              <span><span class="text-[#8FA6B3]">ns</span>&ensp;{b.legend.ns}</span>
              <span><span class="text-[#8FA6B3]">≈</span>&ensp;{tpl(b.legend.noiseFloor, { threshold: String(PRACTICAL_THRESHOLD_MS) })}</span>
              <span>±&ensp;{b.legend.ci}</span>
              <span><span class="text-amber">CV% &gt; 15%</span> = {b.legend.highVariance}</span>
            </div>

            <div class="mt-4 bg-white/[0.05] border border-white/10 rounded-2xl px-4 py-3 text-sm text-[#AFC2CC] flex items-start gap-3">
              <svg class="w-5 h-5 text-amber flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <span>
                <span class="text-paper font-medium">{b.modeCallout}</span>{' '}
                {b.modeCalloutDetail}
              </span>
            </div>

            {p.significantRegressions > 0 && (
              <div class="mt-4 bg-oxide/20 border border-oxide/40 rounded-2xl px-4 py-3 text-sm text-[#FFB4A4]">
                {tpl(b.regressionWarning, { count: String(p.significantRegressions), threshold: String(PRACTICAL_THRESHOLD_MS) })}
              </div>
            )}
          </div>
        ))}
      </div>
    )}

    {hasData && (
      <div class="text-center mt-8">
        <a
          target="_blank"
          href="https://github.com/multipliedtwice/prisma-sql/tree/main/benchmark-results"
          class="text-amber hover:text-[#ffd27a] underline decoration-2 underline-offset-2 text-sm"
        >
          {b.viewRawData}
        </a>
      </div>
    )}

    {b.methodology && (
      <div class="mt-10 max-w-4xl mx-auto bg-white/[0.05] border border-white/10 rounded-2xl px-6 py-5">
        <h3 class="text-sm font-semibold text-paper  mb-3">{b.methodology.title}</h3>
        <ul class="space-y-2 text-sm text-[#8FA6B3]">
          {b.methodology.lines.map((line: string) => (
            <li class="flex gap-2">
              <span class="text-[#8FA6B3] mt-0.5">–</span>
              <span set:html={line.replace(/`([^`]+)`/g, '<code class="bg-white/[0.08] px-1.5 py-0.5 rounded text-xs text-paper">$1</code>')} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', initBenchmarkTabs)
  document.addEventListener('DOMContentLoaded', initBenchmarkTabs)

  function initBenchmarkTabs() {
    const container = document.querySelector<HTMLElement>('[data-benchmark-tabs]')
    if (!container || container.dataset.ready) return
    container.dataset.ready = '1'

    const tabs = container.querySelectorAll<HTMLButtonElement>('[data-tab]')
    const panels = container.querySelectorAll<HTMLElement>('[data-panel]')

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab')
        if (!target) return
        tabs.forEach(t => t.setAttribute('aria-selected', String(t.getAttribute('data-tab') === target)))
        panels.forEach(p => {
          p.hidden = p.getAttribute('data-panel') !== target
        })
      })
    })
  }
</script>

<style>
  .benchmark-tab {
    color: #afc2cc;
  }
  .benchmark-tab:hover {
    color: #eef1ec;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .benchmark-tab[aria-selected='true'] {
    background: #f2a900;
    border-color: #f2a900;
    color: #072536;
  }
</style>
