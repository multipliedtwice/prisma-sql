---
import { cleanLabel } from '../lib/text';

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  tone?: 'ink' | 'oxide';
}

const { badge, title, subtitle, tone = 'ink' } = Astro.props;
---

<section class="border-b border-line">
  <div class="page-x pb-14 pt-12 sm:pb-20 sm:pt-16 lg:pt-20">
    {badge && (
      <span class:list={['inline-flex rounded-full px-3 py-1 text-xs font-semibold', tone === 'oxide' ? 'bg-oxide text-white' : 'bg-ink text-paper']}>
        {cleanLabel(badge)}
      </span>
    )}
    <h1 class="display-1 mt-6 max-w-[16ch] text-ink">{title}</h1>
    {subtitle && <p class="lede mt-8 text-ink/85 lg:max-w-[46rem]">{subtitle}</p>}
  </div>
</section>
