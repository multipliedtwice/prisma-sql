---
import '../styles/global.css'
import { BASE, pageFromPath, pagePath, translatedLocales } from '../lib/i18n-coverage.mjs'

interface Props {
  title: string
  description: string
  locale: string
  keywords?: string
  noindex?: boolean
  structuredData?: Record<string, unknown>
}

const { title, description, locale, keywords, noindex = false, structuredData } = Astro.props

const OG_LOCALES: Record<string, string> = {
  en: 'en_US', es: 'es_ES', fr: 'fr_FR', pt: 'pt_BR', hi: 'hi_IN',
  bn: 'bn_BD', ar: 'ar_AR', ur: 'ur_PK', ru: 'ru_RU', zh: 'zh_CN',
}

const absolute = (path: string) => new URL(path, Astro.site).toString()
const { page } = pageFromPath(Astro.url.pathname)
const translated = translatedLocales(page)
const isTranslated = translated.includes(locale)
const selfPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const canonicalURL = absolute(isTranslated ? selfPath : pagePath(page, 'en'))
const alternateLinks =
  isTranslated && translated.length > 1
    ? translated.map((code) => ({ code, href: absolute(pagePath(page, code)) }))
    : []
const ogImage = absolute(`${BASE}/og-image.png`)
const dir = locale === 'ar' || locale === 'ur' ? 'rtl' : 'ltr'
const base = BASE
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset='UTF-8' />
    <meta
      name='viewport'
      content='width=device-width, initial-scale=1.0, maximum-scale=5.0'
    />
    <meta
      http-equiv='Content-Security-Policy'
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'self';"
    />
    <meta
      http-equiv='Referrer-Policy'
      content='strict-origin-when-cross-origin'
    />

    <title>{title}</title>
    <meta name='title' content={title} />
    <meta name='description' content={description} />
    {keywords && <meta name='keywords' content={keywords} />}
    <meta name='author' content='multipliedtwice' />
    {!noindex && <meta name='robots' content='index, follow' />}

    {!noindex && <link rel='canonical' href={canonicalURL} />}
    {noindex && <meta name='robots' content='noindex, follow' />}

    {alternateLinks.map((l) => (
      <link rel='alternate' hreflang={l.code} href={l.href} />
    ))}
    {alternateLinks.length > 0 && <link rel='alternate' hreflang='x-default' href={absolute(pagePath(page, 'en'))} />}

    <meta property='og:type' content='website' />
    <meta property='og:site_name' content='prisma-sql' />
    <meta property='og:locale' content={OG_LOCALES[locale] ?? 'en_US'} />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:title' content={title} />
    <meta property='og:description' content={description} />
    <meta property='og:image' content={ogImage} />
    <meta property='og:image:width' content='1200' />
    <meta property='og:image:height' content='630' />
    <meta property='og:image:alt' content='prisma-sql: Prisma queries compiled to SQL' />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={title} />
    <meta name='twitter:description' content={description} />
    <meta name='twitter:image' content={ogImage} />

    {structuredData && <script type='application/ld+json' set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}

    <link rel='icon' type='image/x-icon' href={`${base}/favicon.ico`} />
    <link rel='icon' type='image/svg+xml' href={`${base}/favicon.svg`} />
    <link
      rel='icon'
      type='image/png'
      sizes='96x96'
      href={`${base}/favicon-96x96.png`}
    />
    <link
      rel='apple-touch-icon'
      sizes='180x180'
      href={`${base}/apple-touch-icon.png`}
    />
    <link rel='manifest' href={`${base}/site.webmanifest`} />

    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
      }
    </script>

    <slot name='head' />
  </head>
  <body>
    <main>
      <slot />
    </main>

    <script
      is:inline
      src='https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js'
      async></script>
    <script>
      import '../scripts/motion'
    </script>
    <script is:inline>
      if ('loading' in HTMLScriptElement.prototype) {
        document.addEventListener('DOMContentLoaded', function () {
          if (typeof hljs !== 'undefined') {
            hljs.highlightAll()
          }
        })
      } else {
        window.addEventListener('load', function () {
          if (typeof hljs !== 'undefined') {
            hljs.highlightAll()
          }
        })
      }
    </script>
  </body>
</html>
