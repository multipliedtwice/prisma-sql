---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import en from '../i18n/en.json';

interface DocPage {
  path: string;
  title: string;
}

interface Props {
  title: string;
  description: string;
  active: string;
  frontmatter?: Record<string, unknown>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, active } = Astro.props;
const t = en;
const locale = 'en';

const base = '/prisma-sql';

const pages: DocPage[] = [
  { path: `${base}/docs`, title: 'Getting started' },
  { path: `${base}/docs/queries`, title: 'Query examples' },
  { path: `${base}/docs/batch-optimize`, title: '$batch & @optimize' },
  { path: `${base}/docs/planner`, title: 'Cardinality planner' },
  { path: `${base}/docs/configuration`, title: 'Configuration' },
  { path: `${base}/docs/parity`, title: 'Prisma parity map' },
  { path: `${base}/docs/verify`, title: 'Verify parity' },
  { path: `${base}/docs/troubleshooting`, title: 'Troubleshooting & limits' },
];
---

<Layout title={title} description={description} locale={locale}>
  <Header t={t} locale={locale} />

  <div class="page-x py-10 lg:py-14">
    <div class="lg:grid lg:grid-cols-[220px_minmax(0,1fr)] lg:gap-12">
      <aside class="mb-8 lg:mb-0">
        <p class="mb-3 text-sm font-semibold text-fog">Documentation</p>

        <nav class="flex lg:flex-col gap-1 overflow-x-auto pb-2 lg:pb-0" aria-label="Docs">
          {pages.map((p) => (
            <a
              href={p.path}
              aria-current={active === p.path ? 'page' : undefined}
              class:list={[
                'whitespace-nowrap rounded-full px-3.5 py-2 text-[0.95rem] transition-colors',
                active === p.path
                  ? 'bg-ink text-paper font-semibold'
                  : 'text-ink/75 hover:bg-ink/5 hover:text-ink',
              ]}
            >
              {p.title}
            </a>
          ))}
        </nav>

        <div class="hidden lg:block mt-8 border-t border-line pt-4 text-sm">
          <a class="text-fog hover:text-ink" href="https://github.com/multipliedtwice/prisma-sql#readme">Full README</a>
        </div>
      </aside>

      <div class="docs-prose min-w-0">
        <slot />
      </div>
    </div>
  </div>

  <Footer t={t} locale={locale} />
</Layout>

<style>
  .docs-prose :global(h1) {
    @apply text-ink mb-6;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.035em;
  }
  .docs-prose :global(h2) {
    @apply text-ink mt-14 mb-4;
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .docs-prose :global(h3) {
    @apply text-xl font-semibold text-ink mt-8 mb-2;
  }
  .docs-prose :global(p) {
    @apply text-ink/80 leading-relaxed mb-4 max-w-[72ch];
  }
  .docs-prose :global(ul) {
    @apply list-disc ps-6 mb-4 space-y-1 text-ink/80;
  }
  .docs-prose :global(ol) {
    @apply list-decimal ps-6 mb-4 space-y-1 text-ink/80;
  }
  .docs-prose :global(a) {
    @apply text-ink underline decoration-1 underline-offset-[3px] hover:decoration-2;
  }
  .docs-prose :global(code:not(pre code)) {
    @apply bg-paper-2 text-ink rounded px-1.5 py-0.5 text-[0.88em];
  }
  .docs-prose :global(pre) {
    @apply bg-ink-deep text-[#D6E3E8] rounded-2xl p-5 overflow-x-auto text-sm leading-relaxed mb-5;
  }
  .docs-prose :global(pre code) {
    @apply bg-transparent text-[#D6E3E8] p-0;
  }
  .docs-prose :global(table) {
    @apply w-full text-sm mb-4;
  }
  .docs-prose :global(th) {
    @apply text-start font-semibold text-ink px-3 py-2 border-b-2 border-ink;
  }
  .docs-prose :global(td) {
    @apply px-3 py-2.5 border-b border-line text-ink/80 align-top;
  }
  .docs-prose :global(blockquote) {
    @apply border-s-4 border-amber bg-paper-2/70 px-5 py-3 mb-5 text-ink rounded-e-xl;
  }
</style>
